# 账号目录（含 Google 登录凭据和代理密码）、网关密钥，永远不要提交
accounts/
gateway.env
*.env
!gateway.env.example
proxy.env
bin/
venv/
.venv/
__pycache__/
*.pyc
*.log

# 面板和网关运行时生成的文件（含管理员密码哈希、初始密码、调用统计），不要提交
panel.json
panel-initial-password.txt
stats.json
*.tmp

# Docker 数据目录（账号、密钥、面板密码都在这里），安装记录
data/
proxy-history.json
install-info.json
